{
  "说明": "多轮意图评测集：按会话逐轮回放，校验检索门路由(book/history/chat)与历史回忆内容。in_answer 为历史轮必须出现在回答中的子串。",
  "cases": [
    {
      "id": "mt-01-history-last",
      "note": "历史回忆:上一问按记录原文作答;重复追问可命中\"元问题自身也被记录\"的递归;「再上一个呢」语义有歧义,只校验路由",
      "turns": [
        {
          "question": "《三体》中罗辑的咒语指的是什么？",
          "route": "book"
        },
        {
          "question": "我上一个问题是什么？",
          "route": "history",
          "in_answer": "《三体》中罗辑的咒语指的是什么？"
        },
        {
          "question": "我上一个问题是什么？",
          "route": "history",
          "in_answer": "我上一个问题是什么？"
        },
        {
          "question": "再上一个呢？",
          "route": "history"
        }
      ]
    },
    {
