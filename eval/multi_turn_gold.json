{
  "说明": "多轮意图评测集：按会话逐轮回放，校验检索门路由(book/history/chat)与历史回忆内容。in_answer 为历史轮必须出现在回答中的子串。",
  "cases": [
    {
      "id": "mt-01-history-last",
      "note": "历史回忆：上一问 + 递归再上一问，均走 history 且按记录原文作答",
      "turns": [
        {
          "question": "《三体》中罗辑的咒语指的是什么？",
          "route": "book"
        },
        {
          "question": "我上一个问题是什么？",
          "route": "history",
          "in_answer": "《三体》中罗辑的咒语指的是什么？"
        },
        {
          "question": "再上一个呢？",
          "route": "history",
          "in_answer": "我上一个问题是什么？"
        }
      ]
    },
    {
      "id": "mt-02-chitchat",
      "note": "寒暄/闲聊走 chat，不检索书籍",
      "turns": [
        {
          "question": "《三体》中面壁计划是谁提出的？",
          "route": "book"
        },
        {
          "question": "你好",
          "route": "chat"
        },
        {
          "question": "谢谢你的回答",
          "route": "chat"
        }
      ]
    },
    {
      "id": "mt-03-referential-followup",
      "note": "指代追问仍是书问题：必须走 book 检索而非误判为 history/chat",
      "turns": [
