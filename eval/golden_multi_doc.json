{
  "description": "多文档对比问答黄金用例：验证 fan-out 合流不淹没正确文档（documents 顺序故意打乱）",
  "cases": [
    {
      "id": "love-multi-doc",
      "question": "张三喜欢谁？",
      "documents": ["张三爱情故事.txt", "名词大动词.txt"],
      "expect_keywords": ["李四"]
    },
    {
      "id": "shaobai-multi-doc",
      "question": "少白公在哪一年失去权力？",
      "documents": ["名词大动词.txt", "张三爱情故事.txt"],
      "expect_keywords": ["1966", "一九六六"]
    },
    {
      "id": "love-multi-reversed",
      "question": "朱六想说服张三喜欢谁？",
      "documents": ["名词大动词.txt", "张三爱情故事.txt"],
      "expect_keywords": ["王五"]
    },
    {
      "id": "santi-multi-doc",
      "question": "罗辑在哪里听到对他的任命？",
      "documents": ["sample_duplicate.txt", "名词大动词.txt"],
      "expect_keywords": ["联合国", "大会堂"]
    }
  ]
}
