# --- 应用 ---
APP_NAME=ReadingAssistant
DATABASE_URL=postgresql+psycopg://example:password@localhost:5432/reading_agent?sslmode=disable

# --- LLM：DeepSeek ---
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=<your deepseek api key>

# --- Embedding: DashScope ---
EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_API_KEY=<your dashscope api key>

# --- 向量库（ChromaDB）---
CHROMA_PERSIST_DIR=rag/chroma_data
CHROMA_COLLECTION_NAME=reading_agent_chunks
MD5_HEX_STORE: md5.txt
ALLOWED_KNOWEDGE_FILE_TYPE: ['txt','pdf','epub']
SEPARATORS: [ '\n\n','\n','.','!','?','。','！','？',' ','' ]

# --- RAG 参数 ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=6

# --- 服务 ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
