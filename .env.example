# --- 应用 ---
APP_NAME=ReadingAssistant
DATABASE_URL=postgresql+psycopg://psql_reading:psql_reading@localhost:5432/reading_agent?sslmode=disable

# --- LLM：DeepSeek ---
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=<your deepseek api key>

# --- Embedding: DashScope ---
EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_API_KEY=<your dashscope api key>

# --- 向量库（ChromaDB）---
CHROMA_PERSIST_DIR=rag/chroma_db
CHROMA_COLLECTION_NAME=reading_agent_chunks
VECTOR_STORE_BACKEND=chroma

# --- RAG 参数 ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=6

# --- 意图识别级联（规则 → 向量原型 → LLM，见 src/reading_assistant/graph/intent.py）---
# L1 规则快通道：高精度正则，命中即零 LLM 调用
INTENT_RULES_ENABLED=true
# L2 向量原型层置信阈值；<=0 停用该层（意图判定全部回落 LLM 兜底）
INTENT_PROTOTYPE_THRESHOLD=0.75
# L2 判 book 需领先 chat/history 的最小余弦幅度（防「book 和 history 一样高」时乱判）
INTENT_PROTOTYPE_MARGIN=0.08

# --- 服务 ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
